{
  "name": "atlantic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "test:unit": "node --experimental-transform-types --test tests/unit.test.mjs",
    "test:integration": "node --test tests/api.test.mjs",
    "migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "ingest": "node --env-file-if-exists=.env pipeline/limpieza.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "framer-motion": "^13.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
