# Credenciales de Postgres. Cambiarlas ANTES de un despliegue real: estos valores
# son los de desarrollo y estan en el repositorio a proposito.
POSTGRES_USER=atlantic
POSTGRES_PASSWORD=atlantic
POSTGRES_DB=atlantic
POSTGRES_PORT=5432

# API: cuando corre en Docker, compose sobrescribe el host con el servicio "db".
DATABASE_URL=postgres://atlantic:atlantic@localhost:5432/atlantic
APP_PORT=3000

# Pool de conexiones del API.
DB_POOL_MAX=10
# Peticiones por minuto y por IP en /api (proteccion antispam en proxy.ts).
RATE_LIMIT_MAX=120
